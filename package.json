{
  "name": "cloudflare-proxy-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Cloudflare Worker & Pages Proxy Lab",
  "workspaces": [
    "worker",
    "pages"
  ],
  "scripts": {
    "dev": "npm --workspace=worker run dev",
    "pages:dev": "npm --workspace=pages run dev",
    "pages:build": "npm --workspace=pages run build",
    "deploy": "npm --workspace=worker run deploy",
    "test": "npm --workspace=worker run test",
    "typecheck": "npm --workspace=worker run typecheck && npm --workspace=pages run typecheck"
  }
}
